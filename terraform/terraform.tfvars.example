# Copy to terraform.tfvars (gitignored) and fill in.

letsencrypt_email = "you@example.com"

server_name = "aveeus"
server_type = "cx22"
location    = "nbg1" # or fsn1 / hel1

domain               = "aveeus.ovh"
cloudflare_zone_name = "aveeus.ovh"
manage_dns           = true
dns_proxied          = false # true = Cloudflare orange-cloud proxy
create_www_cname     = true

# Keep a stable public IP across server destroy/create
use_floating_ip = true

ssh_public_key_path  = "~/.ssh/id_ed25519.pub"
ssh_private_key_path = "~/.ssh/id_ed25519"

# Tighten SSH once you know your IP, e.g. ["203.0.113.10/32"]
allowed_ssh_cidrs = ["0.0.0.0/0", "::/0"]

infra_repo_url    = "https://github.com/GeneralKnowledge/cautious-tribble.git"
infra_repo_branch = "main"
app_repo_url      = "https://github.com/GeneralKnowledge/Continuous-Tunes.git"
