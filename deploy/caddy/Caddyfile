	email {$EMAIL}
}

{$DOMAIN} {
	encode gzip
	reverse_proxy web:80

	header {
		# Static SPA — keep CSP loose enough for Strudel / GitHub samples
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}

www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}
